# ===== HTTP =====
PORT=8080

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=ttml
DB_PASSWORD=ttml
DB_NAME=ttml_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ttml-db
MINIO_USE_SSL=false

# ===== RabbitMQ =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672/amllhub
RABBITMQ_QUEUE=sync_queue
RABBITMQ_DLQ=sync_queue.dlq
RABBITMQ_NF_QUEUE=not_found_parse_queue
RABBITMQ_NF_DLQ=not_found_parse_queue.dlq

# ===== 投稿数据迁移队列 =====
RABBITMQ_MIGRATION_EXCHANGE=ttml.migration
RABBITMQ_MIGRATION_QUEUE=migration.user
RABBITMQ_MIGRATION_DLQ=migration.user.dlq
RABBITMQ_MIGRATION_CLOSE_QUEUE=migration.close_pr
RABBITMQ_MIGRATION_CLOSE_DLQ=migration.close_pr.dlq
# 迁移起始 PR 号（含），该号之前的 PR 不迁移
MIGRATION_PR_START_NUMBER=7390
# 迁移时 GitHub API 请求并发上限（≤10）
MIGRATION_CONCURRENCY=10
# 每处理多少条 PR 刷新一次任务进度
MIGRATION_BATCH_SIZE=20
# 迁移完成后是否自动关闭已迁移的 GitHub PR（默认关闭）
MIGRATION_CLOSE_PR_ENABLED=false

# ===== MeiliSearch =====
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meili-master-key
MEILISEARCH_INDEX=songs

# ===== GitHub =====
GITHUB_TOKEN=
GITHUB_REPO=amll-dev/amll-ttml-db
GITHUB_BRANCH=main

# ===== GitHub App =====
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_REPO_OWNER=amll-dev
GITHUB_APP_REPO_NAME=amll-ttml-db
GITHUB_APP_UPLOAD_FOLDER=raw-lyrics

# ===== GitHub OAuth=====
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# ===== Submission 投稿模块 =====
SUBMISSION_AUTO_REJECT_INTERVAL=1h
SUBMISSION_AUTO_REJECT_AFTER=96h
SUBMISSION_REVIEWER_CACHE_TTL=30s
SUBMISSION_MAX_TTML_SIZE=2097152
SUBMISSION_MAX_AUDIO_SIZE=52428800
SUBMISSION_MAX_IMAGE_SIZE=10485760

# ===== Worker =====
WORKER_CONCURRENCY=20
WORKER_BATCH_SIZE=100
SYNC_LOCK_TTL=3600
INCREMENTAL_THRESHOLD=200
WORKER_BASE_URL=http://localhost:9090

# ===== NCM API =====
NCM_API_BASE=https://ncmapi.bikonoo.com
NCM_MUSIC_U=

# ===== 邮件通知=====
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=AMLL Hub
# 站点地址
SITE_URL=http://localhost:5173
# 用户名→邮箱的缓存时长
EMAIL_CACHE_TTL=10m
# 单次发送超时（秒）
EMAIL_TIMEOUT_SEC=15

# ===== Casdoor =====
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=amll
CASDOOR_APPLICATION=amll-hub
CASDOOR_JWT_SECRET=
CASDOOR_JWT_TTL=24h
